@startuml diagramaUML

class App {
    + main(args: String[]): void
}

class ConexionTester {
    - lblUrl: JLabel
    - lblUsuario: JLabel
    - lblPassword: JLabel
    - txtUrl: JTextField
    - txtUsuario: JTextField
    - txtPassword: JPasswordField
    - btnProbar: JButton
    - txtResultado: JTextArea
    + ConexionTester()
}

class ConexionBD {
    - url: String
    - user: String
    - password: String
    + ConexionBD(url: String, user: String, password: String)
    + conectar(): Connection
}

class JFrame <<external>> <<javax.swing>> {
}

App --> ConexionTester : crea
ConexionTester --> ConexionBD : usa
ConexionTester --|> JFrame : hereda

@enduml